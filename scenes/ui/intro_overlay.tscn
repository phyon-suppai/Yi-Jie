text = "世界规则"
horizontal_alignment = 1

[node name="StoryLabel" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.78, 0.82, 1)
theme_override_font_sizes/font_size = 17
text = "这是一场与内心情绪的对话。不同时期有不同的烦恼——怀疑、焦虑、孤独。我们需要在正确的时间里，用正确的方式面对它们。"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Rule" type="HSeparator" parent="Center/Panel/Margin/VBox"]
layout_mode = 2

[node name="MechanicLabel" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.9, 0.94, 1)
theme_override_font_sizes/font_size = 17
text = "💜 精力：会随时间流失，被烦恼缠身时掉得更快；击碎烦恼、正确应对特殊事件，可回补精力。

🕹 移动 —— W A S D
🎯 攻击 —— J（行动·绿）K（表达·蓝）L（接受·红）
🎨 同色克制：绿色行动克怀疑、蓝色表达克孤独、红色接受克焦虑。

⚠ 特殊方块会快速冲向你，触发内心对话，用 J / K / L 三选一。
    正确面对会恢复精力；错误逃避会扣除精力，并额外刷新焦虑方块。

🚪 通关 —— 在当前阶段积累足够的成就值，即可进入下一时期。"
autowrap_mode = 2

[node name="Spacer" type="Control" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="StartButton" type="Button" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_pressed_color = Color(1, 0.92, 0.92, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 22
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_normal")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
text = "开始战斗"
